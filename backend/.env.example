# ==============================================================================
# Saheli AI Backend Environment Configuration (Render Free & Firebase Spark Plan)
# Never commit real keys or secrets to git.
# ==============================================================================

ENV=development
PORT=8080

# Firebase Spark Plan
FIREBASE_PROJECT_ID=saheli-2576f
GOOGLE_CLOUD_PROJECT=saheli-2576f

# Base64-encoded Firebase Service Account JSON (Render Free / Production)
# Generate via: base64 -w 0 path/to/serviceAccountKey.json
# On Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# Gemini API (Free tier compatible key)
GEMINI_API_KEY=replace-with-gemini-key

# CORS: Local development and deployed Vercel frontend
CORS_ORIGINS=http://localhost:3000,https://saheli.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Mocks (Set false in production on Render)
ENABLE_DEMO_MOCKS=true
